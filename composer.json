{
    "name": "endurance/workout-fit",
    "description": "Explicit FIT Workout interpretation into immutable Endurance Workout prescriptions",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "endurance/fit": "^0.2.0",
        "endurance/workout": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Endurance\\WorkoutFit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Endurance\\WorkoutFit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
